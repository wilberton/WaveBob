mod effects {
    pub trait Effect {fn process(&mut self, b:&mut [f32]);fn reset(&mut self) {} fn extra(&self)->Option<(usize,&[f32])>{None}}
    fn field(b:&[u8],i:usize)->Option<i32>{Some(i32::from_le_bytes(b.get(i*4..i*4+4)?.try_into().ok()?))}
    fn ints<const N:usize>(b:&[u8],offset:usize)->Option<[i32;N]> {let mut v=[0;N];for (i,x) in v.iter_mut().enumerate(){*x=i32::from_le_bytes(b.get((offset+i)*4..(offset+i+1)*4)?.try_into().ok()?);}Some(v)}
    fn state_of(v:&[i32])->Vec<u8>{v.iter().flat_map(|x|x.to_le_bytes()).collect()}
    #[path="@ROOT@/crates/os-engine/src/effects/stereo_enhancer.rs"]pub mod stereo_enhancer;
    #[path="@ROOT@/crates/os-engine/src/effects/stereo_shaper.rs"]pub mod stereo_shaper;
}
fn main(){let args:Vec<_>=std::env::args().collect();let mut b:Vec<f32>=std::fs::read(&args[1]).unwrap().chunks_exact(4).map(|b|f32::from_le_bytes(b.try_into().unwrap())).collect();let v:Vec<i32>=args[3].split(',').map(|s|s.parse().unwrap()).collect();let rate:u32=args[4].parse().unwrap();let mut r=effects::stereo_shaper::StereoShaper::with_settings(rate,&effects::stereo_shaper::Settings{v:[v[0],v[1],v[2],v[3],v[4],v[5],0,v[6]]});r.flush();let delay=r.delay();b.resize(b.len()+rate as usize*4,0.0);for chunk in b.chunks_mut(128){effects::Effect::process(&mut r,chunk);}std::fs::write(&args[2],b.iter().flat_map(|x|x.to_le_bytes()).collect::<Vec<_>>()).unwrap();println!("{delay}");}
